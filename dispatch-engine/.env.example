# Copie pra .env (gitignored) pra rodar localmente, ou configure essas
# mesmas variáveis direto no painel do Railway pro deploy real. Nenhum valor
# aqui é real — são só os nomes das variáveis esperadas.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
PORT=3000
# JSON inteiro da service account do Firebase, como string (Project Settings >
# Service Accounts > Generate new private key) — pro push nativo do entregador
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# Segredo compartilhado da rota GET /admin/hub-metricas -- quem chama é o
# backend do hub OmniFlow Studio, autenticado por header X-Hub-Key em vez
# de login. Precisa ser IDÊNTICO ao GIROCERTO_DISPATCH_HUB_KEY no .env do
# omniflow-studio. Gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUB_METRICS_KEY=64-caracteres-hex-gerados-por-voce-nunca-comitar-o-valor-real
